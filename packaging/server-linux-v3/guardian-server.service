[Unit]
Description=Guardian 3.0 server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=guardian
Group=guardian
StateDirectory=guardian
StateDirectoryMode=0750
ExecStart=/usr/local/bin/guardian-server --data-dir /var/lib/guardian
Restart=always
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Lets an admin move the server to port 443 with --listen 0.0.0.0:443.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
